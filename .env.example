GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

GOOGLE_TOKEN_DIRECTORY=tokens
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_USERS_COLLECTION=users
POCKETBASE_TRANSACTIONS_COLLECTION=transactions
ENCRYPTION_PUBLIC_KEY_PATH=keys/public.pem
ENCRYPTION_PRIVATE_KEY_PATH=keys/private.pem
ENCRYPTION_KEY_ID=local-v1
DEVICE_JWT_SECRET=
DATA_DIRECTORY=data


# Google-only authentication (no PocketBase login)
# Add the frontend origin in Google Cloud's OAuth client authorized JavaScript origins.
# Use a persistent Railway volume for DATA_DIRECTORY; sessions and encrypted records live there.
FRONTEND_URL=http://localhost:15684
FRONTEND_ORIGINS=http://localhost:15684,http://127.0.0.1:15684
DATA_DIRECTORY=./data
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Local callback, routed through the same-origin Vite API proxy:
# GOOGLE_REDIRECT_URI=http://localhost:15684/api/auth/google/callback
# Production: use your HTTPS frontend origin and set SESSION_COOKIE_SECURE=true.

